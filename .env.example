# Copy to .env and fill in. The SDK reads these when arguments are omitted.

# Your Loaf API key, shown ONCE when you create it in the web app (log in ->
# Settings -> API keys -> Create): 64 hex characters, no prefix. It is the Bearer
# for reads, cancels, the WebSocket and the account reads an order needs (its key
# state, its order indices); it is never sent with an order. It stops working when
# it expires (at most 180 days) or is deleted, so note its expiry date.
LOAF_API_KEY=

# REST base URL, INCLUDING the trailing /api.
#   Production:     https://api.loafmarkets.com/api
LOAF_API_BASE_URL=https://api.loafmarkets.com/api

# Optional: max slippage in basis points (100 = 1%; default 200) for every price
# the SDK derives for you: MARKET worst prices, *_MARKET stops / takes and TP/SL
# legs. Override per order with max_slippage_bps= / leg_max_slippage_bps=.
# LOAF_MAX_SLIPPAGE_BPS=200

# Optional: override the WebSocket URL. If unset it is derived from the base URL
# (https://host/api -> wss://host/ws, http://host/api -> ws://host/ws).
# LOAF_WS_URL=ws://localhost:8005/ws

# Your account's L2 TRADING KEY (80 lowercase hex): it signs every order.
# Derive and register it once from your wallet (needs the l2keys extra):
#   LOAF_WALLET_PRIVATE_KEY=... LOAF_L1_RPC_URL=... python -m loaf.l2.keys enable
# Anyone who holds it can trade for this account: keep it as secret as the wallet key.
LOAF_L2_SECRET_KEY=

# Only for the wallet flows (python -m loaf.l2.keys, offerings.subscribe):
# LOAF_WALLET_PRIVATE_KEY=     # the wallet of the API key's user
# LOAF_L1_RPC_URL=             # an RPC of the custody chain (property.l2Market.chainId)
# LOAF_IPO_RPC_URL=            # an RPC of an offering's sale chain (ipoChainId)

# Optional L2 signing settings (defaults shown):
# LOAF_L2_CHAIN_ID=1819238758      # the ZkLoaf L2 chain id
# LOAF_L2_FEE_RATE_CAP=7000        # the fee you consent to, per million (70 bps)
# LOAF_L2_ORDER_TTL_MS=604800000   # how long an order rests (7 days past the 1-day buffer)
# LOAF_L2_ORDER_INDEX_BLOCK=64     # order indices reserved at a time, 1 to 4096
