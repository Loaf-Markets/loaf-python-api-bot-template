# Copy to .env and fill in. The SDK reads these when arguments are omitted.

# Your Loaf API key has TWO values, both shown ONCE when you create the key in the
# web app (log in -> Settings -> API keys -> Create). Both stop working together
# when the key expires (at most 180 days) or is deleted, so note its expiry date.

# 1. API token: the Bearer for reads, cancels and the WebSocket.
#    64 hex characters, no prefix.
LOAF_API_KEY=

# 2. Agent private key: signs every order on this machine and is never sent.
#    It can place orders for your account but cannot withdraw. Keep it secret.
#    0x followed by 64 hex characters.
LOAF_AGENT_PRIVATE_KEY=

# REST base URL, INCLUDING the trailing /api.
#   Production:     https://api.loafmarkets.com/api
LOAF_API_BASE_URL=https://api.loafmarkets.com/api

# Optional: max slippage in basis points (100 = 1%; default 200) for every price
# the SDK derives for you: MARKET worst prices, *_MARKET stops / takes and TP/SL
# legs. Override per order with max_slippage_bps= / leg_max_slippage_bps=.
# LOAF_MAX_SLIPPAGE_BPS=200

# Optional: override the WebSocket URL. If unset it is derived from the base URL
# (https://host/api -> wss://host/ws, http://host/api -> ws://host/ws).
# LOAF_WS_URL=ws://localhost:8005/ws
