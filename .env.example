# Copy to .env, make it readable only by you (chmod 600 .env), and fill in.
# The SDK reads these when arguments are omitted.

# Your trading key: the one credential the SDK needs (README §2). In the web
# app's API page (log in -> API), select "Show trading key" under Trading key
# (deposit and enable trading on a market's Trade page first), and copy the one
# string it shows, loaf_tk_<chain>_<account>_<80 hex>, whole.
# It signs every order and perps margin move or exit on this machine, and the
# short-lived login tokens that authenticate your reads, cancels, perps ops and
# private WebSocket channel; it is never sent itself. Keep it as secret as your wallet key: whoever holds it can trade
# your balance away. A "Reset trading key" changes it.
#   NEVER put your wallet key in this file.
LOAF_TRADING_KEY=

# REST base URL, INCLUDING the trailing /api.
#   Production:     https://api.loafmarkets.com/api
LOAF_API_BASE_URL=https://api.loafmarkets.com/api

# Optional: max slippage in basis points (100 = 1%; default 200) for every price
# the SDK derives for you: MARKET worst prices, *_MARKET stops / takes and TP/SL
# legs. Override per order with max_slippage_bps= / leg_max_slippage_bps=.
# LOAF_MAX_SLIPPAGE_BPS=200

# Optional: override the WebSocket URL. If unset it is derived from the base URL
# (https://host/api -> wss://host/ws, http://host/api -> ws://host/ws).
# LOAF_WS_URL=ws://localhost:8005/ws
